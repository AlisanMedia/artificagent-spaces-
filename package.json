{
  "name": "artificagent-spaces",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Synthetic local ArtificAgent Spaces platform with tenant RLS, actual media, 3D, scoped guide and analytics; live integrations disabled.",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": "11.9.0"
  },
  "scripts": {
    "demo:local": "tsx scripts/local-lab.ts demo",
    "worker:local": "node scripts/local-worker.mjs",
    "dev": "node scripts/next.mjs dev",
    "build": "npm run production:verify && npm run services:verify && npm run showcase:verify && node scripts/next.mjs build",
    "start": "node scripts/next.mjs start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "node scripts/next.mjs typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "security:check": "node scripts/security-check.mjs",
    "security:secrets": "bash scripts/scan-secrets.sh",
    "test:governance": "node --test --test-isolation=none tests/governance/*.test.mjs",
    "ci:summary": "node scripts/ci-summary.mjs",
    "security:audit": "npm audit --audit-level=high",
    "licenses": "node scripts/license-inventory.mjs",
    "sbom": "npm run licenses && node scripts/sbom.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run security:check && npm run build",
    "demo:ux": "tsx scripts/ux-samples.ts",
    "lab:fixtures": "tsx scripts/v4-fixtures.ts",
    "lab:video": "tsx scripts/video-quality-lab.ts",
    "economics": "tsx scripts/unit-economics.ts",
    "benchmark:plan": "tsx scripts/provider-benchmark-plan.ts",
    "golden:build": "tsx scripts/golden-property.ts",
    "golden:verify": "tsx scripts/golden-property.ts --verify",
    "preview:build": "tsx scripts/build-owner-preview.ts",
    "preview:serve": "node scripts/serve-owner-preview.mjs",
    "preview:test": "playwright test -c playwright.preview.config.ts",
    "usability:prepare": "tsx scripts/usability-evaluation.ts prepare",
    "usability:summarize": "tsx scripts/usability-evaluation.ts summarize",
    "showcase:verify": "tsx scripts/verify-showcase.ts",
    "services:verify": "tsx scripts/verify-service-catalog.ts",
    "production:verify": "tsx scripts/verify-production-services.ts",
    "showcase:build": "tsx scripts/build-showcase-v55.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@elevenlabs/react": "1.19.1",
    "jose": "6.2.13",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5",
    "esbuild": "0.28.2"
  }
}
