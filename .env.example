# Local-only synthetic data. Values below are empty placeholders, never live credentials.
SPACES_LOCAL_DATA_DIR=.spaces-local
# Production secret names are listed in docs/release-playbook.md.
# Never place real credentials here, in chat, or in browser/public variables.
SPACES_PROVIDER_LIVE_ENABLED=false
SPACES_EXTERNAL_MAX_USD=0
# These flags alone CANNOT activate a transport; adapters are code-locked DISABLED.
# Future owner-approved server secret manager only; do not populate this tracked file.
FAL_KEY=
WORLDLABS_API_KEY=
PEDRA_API_KEY=

# V01 only: these public verification keys are SERVER configuration, not browser variables.
# Empty values cannot activate anything; an independently signed exact-source/count/budget test permit is also required.
# Existing provider locks and USD0 remain. Never add a real signing private key to this repository.
SPACES_V01_APPROVER_PUBLIC_KEY=
SPACES_V01_REVIEWER_PUBLIC_KEY=
